{
  "manifestVersion": 2,
  "id": "vim-editor",
  "name": "Vim Editor",
  "version": "0.3.2",
  "description": "Vim keybindings (CodeMirror 6 + codemirror-vim) for files in Orca's editor tab.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "sandboxed-ui",
  "pluginApi": 1,
  "capabilities": [
    {
      "kind": "settings:own"
    }
  ],
  "contributes": {
    "customEditors": [
      {
        "id": "vim-js",
        "title": "Vim",
        "extensions": [
          ".js",
          ".mjs",
          ".cjs",
          ".jsx"
        ],
        "entry": "editor/langs/js.ts",
        "priority": "default",
        "frame": "isolated",
        "icon": "assets/icon.png"
      },
      {
        "id": "vim-ts",
        "title": "Vim",
        "extensions": [
          ".ts",
          ".mts",
          ".cts",
          ".tsx"
        ],
        "entry": "editor/langs/ts.ts",
        "priority": "default",
        "frame": "isolated",
        "icon": "assets/icon.png"
      },
      {
        "id": "vim-json",
        "title": "Vim",
        "extensions": [
          ".json",
          ".jsonc",
          ".json5"
        ],
        "entry": "editor/langs/json.ts",
        "priority": "default",
        "frame": "isolated",
        "icon": "assets/icon.png"
      },
      {
        "id": "vim-markdown",
        "title": "Vim",
        "extensions": [
          ".md",
          ".markdown",
          ".mdx"
        ],
        "entry": "editor/langs/markdown.ts",
        "priority": "default",
        "frame": "isolated",
        "icon": "assets/icon.png"
      },
      {
        "id": "vim-python",
        "title": "Vim",
        "extensions": [
          ".py",
          ".pyi"
        ],
        "entry": "editor/langs/python.ts",
        "priority": "default",
        "frame": "isolated",
        "icon": "assets/icon.png"
      },
      {
        "id": "vim-css",
        "title": "Vim",
        "extensions": [
          ".css",
          ".scss",
          ".less"
        ],
        "entry": "editor/langs/css.ts",
        "priority": "default",
        "frame": "isolated",
        "icon": "assets/icon.png"
      },
      {
        "id": "vim-html",
        "title": "Vim",
        "extensions": [
          ".html",
          ".htm",
          ".vue",
          ".svelte"
        ],
        "entry": "editor/langs/html.ts",
        "priority": "default",
        "frame": "isolated",
        "icon": "assets/icon.png"
      },
      {
        "id": "vim-yaml",
        "title": "Vim",
        "extensions": [
          ".yml",
          ".yaml"
        ],
        "entry": "editor/langs/yaml.ts",
        "priority": "default",
        "frame": "isolated",
        "icon": "assets/icon.png"
      },
      {
        "id": "vim-rust",
        "title": "Vim",
        "extensions": [
          ".rs"
        ],
        "entry": "editor/langs/rust.ts",
        "priority": "default",
        "frame": "isolated",
        "icon": "assets/icon.png"
      },
      {
        "id": "vim-go",
        "title": "Vim",
        "extensions": [
          ".go"
        ],
        "entry": "editor/langs/go.ts",
        "priority": "default",
        "frame": "isolated",
        "icon": "assets/icon.png"
      },
      {
        "id": "vim-perl",
        "title": "Vim",
        "extensions": [
          ".pl",
          ".pm",
          ".cgi"
        ],
        "entry": "editor/langs/perl.ts",
        "priority": "default",
        "frame": "isolated",
        "icon": "assets/icon.png"
      },
      {
        "id": "vim-xml",
        "title": "Vim",
        "extensions": [
          ".xml",
          ".svg",
          ".plist"
        ],
        "entry": "editor/langs/xml.ts",
        "priority": "default",
        "frame": "isolated",
        "icon": "assets/icon.png"
      },
      {
        "id": "vim-sql",
        "title": "Vim",
        "extensions": [
          ".sql"
        ],
        "entry": "editor/langs/sql.ts",
        "priority": "default",
        "frame": "isolated",
        "icon": "assets/icon.png"
      },
      {
        "id": "vim-php",
        "title": "Vim",
        "extensions": [
          ".php"
        ],
        "entry": "editor/langs/php.ts",
        "priority": "default",
        "frame": "isolated",
        "icon": "assets/icon.png"
      },
      {
        "id": "vim-plain",
        "title": "Vim",
        "extensions": [
          ".txt",
          ".log",
          ".conf",
          ".ini",
          ".toml",
          ".sh",
          ".zsh",
          ".bash",
          ".rb",
          ".java",
          ".c",
          ".h",
          ".cpp",
          ".hpp",
          ".swift",
          ".kt",
          ".lua",
          ".vim",
          ".cfg",
          ".csv",
          ".tsv",
          ".diff",
          ".patch",
          ".cs",
          ".dart",
          ".ex",
          ".exs",
          ".zig"
        ],
        "entry": "editor/langs/plain.ts",
        "priority": "default",
        "frame": "isolated",
        "filenames": [
          ".env",
          ".gitignore",
          ".zshrc",
          ".bashrc",
          ".vimrc",
          "Makefile",
          "Dockerfile"
        ],
        "icon": "assets/icon.png"
      }
    ],
    "settings": [
      {
        "key": "highlight.enabled",
        "title": "シンタックスハイライト",
        "description": "オフにすると、テキストを色付けせずに表示します。",
        "type": "boolean",
        "default": true
      },
      {
        "key": "highlight.theme",
        "title": "配色テーマ",
        "description": "「Orca に合わせる」は、Orca がダークなら One Dark、ライトなら CodeMirror 標準の配色を使います。",
        "type": "string",
        "default": "auto",
        "enum": [
          "auto",
          "one-dark",
          "light",
          "github-light",
          "github-dark",
          "solarized"
        ],
        "enumLabels": [
          "Orca に合わせる",
          "One Dark",
          "ライト（CodeMirror 標準）",
          "GitHub 風ライト",
          "GitHub 風ダーク",
          "Solarized 風"
        ]
      },
      {
        "key": "color.keyword",
        "title": "色: キーワード",
        "description": "配色テーマの色を上書きします。#rrggbb などの CSS の色を指定します。空欄ならテーマの色を使います。",
        "type": "string",
        "default": "",
        "maxLength": 64,
        "placeholder": "#c678dd"
      },
      {
        "key": "color.string",
        "title": "色: 文字列",
        "description": "配色テーマの色を上書きします。#rrggbb などの CSS の色を指定します。空欄ならテーマの色を使います。",
        "type": "string",
        "default": "",
        "maxLength": 64,
        "placeholder": "#98c379"
      },
      {
        "key": "color.comment",
        "title": "色: コメント",
        "description": "配色テーマの色を上書きします。#rrggbb などの CSS の色を指定します。空欄ならテーマの色を使います。",
        "type": "string",
        "default": "",
        "maxLength": 64,
        "placeholder": "#7f848e"
      },
      {
        "key": "color.number",
        "title": "色: 数値",
        "description": "配色テーマの色を上書きします。#rrggbb などの CSS の色を指定します。空欄ならテーマの色を使います。",
        "type": "string",
        "default": "",
        "maxLength": 64,
        "placeholder": "#d19a66"
      },
      {
        "key": "color.function",
        "title": "色: 関数名",
        "description": "配色テーマの色を上書きします。#rrggbb などの CSS の色を指定します。空欄ならテーマの色を使います。",
        "type": "string",
        "default": "",
        "maxLength": 64,
        "placeholder": "#61afef"
      },
      {
        "key": "color.type",
        "title": "色: 型・クラス名",
        "description": "配色テーマの色を上書きします。#rrggbb などの CSS の色を指定します。空欄ならテーマの色を使います。",
        "type": "string",
        "default": "",
        "maxLength": 64,
        "placeholder": "#e5c07b"
      },
      {
        "key": "color.property",
        "title": "色: プロパティ・属性名",
        "description": "配色テーマの色を上書きします。#rrggbb などの CSS の色を指定します。空欄ならテーマの色を使います。",
        "type": "string",
        "default": "",
        "maxLength": 64,
        "placeholder": "#e06c75"
      },
      {
        "key": "color.tag",
        "title": "色: タグ名（HTML / XML）",
        "description": "配色テーマの色を上書きします。#rrggbb などの CSS の色を指定します。空欄ならテーマの色を使います。",
        "type": "string",
        "default": "",
        "maxLength": 64,
        "placeholder": "#e06c75"
      }
    ]
  },
  "icon": "assets/icon.png"
}
